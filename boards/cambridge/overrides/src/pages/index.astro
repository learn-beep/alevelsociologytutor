---
import Base from '../layouts/Base.astro';
import { allTopics, allQuestions, allPapers, groupInfo } from '../lib/data';
import { decks } from '../lib/decks';
import Icon from '../components/Icon.astro';
const order = ['family-diversity-and-change','research-methods','social-identity','socialisation-and-culture','perspectives-on-the-family','gender-roles-and-family-life','childhood-and-age','role-of-education','positivism-and-interpretivism','gender-and-attainment','social-class-and-attainment','global-poverty-and-inequality','media-ownership-and-control','media-effects','religion-and-social-order','secularisation'];
const top = order.map((s) => allTopics.find((t) => t.slug === s)).filter(Boolean);
const topics = allTopics.map((t) => ({ slug: t.slug, name: t.name, parts: t.parts }));
const essays = allQuestions.filter((q) => q.format === 'Essay').length;
const current = allQuestions.filter((q) => !q.notCurrentSpec).length;
const latest = 'November 2025';
const exams = allPapers.filter((p) => p.kind === 'exam').length;
---
<Base title="Cambridge International AS & A Level Sociology 9699: past-paper questions by topic, mark schemes and tutors" description="Free Cambridge International AS and A Level Sociology (9699) past-paper questions sorted by syllabus topic, with mark schemes, examiners' reports, practice, essays and a grade calculator." context="home" leadLine="Not sure where to start? Tell us the year group, the papers you are sitting and your target grade and we will arrange a trial session.">
  <h1>Cambridge International AS &amp; A Level Sociology, one topic at a time</h1>
  <p>{current.toLocaleString()} question parts from {exams} Cambridge 9699 papers, March 2021 to {latest}, in every time-zone variant, plus Cambridge's specimen papers. Each is sorted by syllabus topic, with the mark scheme (its levels of response highlighted for the part) and the examiners' report one tap away. Free, no sign-up.</p>
  <p class="board-note">Taking AQA (7192 or 7191) instead? The <a href="/">AQA section</a> has every AQA paper since 2016.</p>
  <p class="muted">Syllabus 9699 (first examined 2021): Paper 1 Socialisation, Identity and Methods of Research and Paper 2 The Family (AS Level); Paper 3 Education and Paper 4 Globalisation, Media and Religion (A Level). The June 2026 papers will be added when they become public.</p>

  <div class="progress-box" id="progress" hidden>
    <strong>Your progress</strong>
    <dl><div><dt>Checklist ticks</dt><dd id="pr-ticks">0</dd></div><div><dt>Questions marked</dt><dd id="pr-q">0</dd></div><div><dt>Weakest topic</dt><dd id="pr-weak">—</dd></div></dl>
    <a href="/planner/">Build a plan from these</a> · <a href="/specification/">Checklist</a>
  </div>

  <nav class="tool-strip" aria-label="Key tools">
    <a href="/practice/"><Icon name="target" />Practice</a>
    <a href="/past-papers/"><Icon name="file" />Past papers</a>
    <a href="/essays/"><Icon name="pen" />Essays</a>
    <a href="/flashcards/"><Icon name="layers" />Key terms</a>
    <a href="/mock/"><Icon name="timer" />Mock</a>
  </nav>

  <label for="topic-search" class="muted">Find a topic</label>
  <input id="topic-search" class="search" type="search" placeholder="e.g. secularisation, socialisation, family diversity" autocomplete="off" />

  <h2 class="strand-head">Most-examined topics</h2>
  <ul class="topic-list" id="topic-list">
    {top.map((t) => <li><a href={`/questions/${t.slug}/`}><span>{t.name}</span><span class="strand"><span class={`badge badge-${groupInfo(t.group).badge}`}>{groupInfo(t.group).short}</span> {t.parts} parts</span></a></li>)}
  </ul>
  <p><a href="/questions/">All {allTopics.length} topics by paper</a></p>

  <h2>Everything on the site</h2>
  <div class="tiles">
    <a class="tile-card" href="/past-papers/"><Icon name="file" /><strong>Past papers</strong><span>Every 9699 paper since 2021 (March, June and November, all variants) with a question-by-question table</span></a>
    <a class="tile-card" href="/practice/"><Icon name="target" /><strong>Practice</strong><span>Real questions one at a time, self-marked against the mark scheme and the levels of response</span></a>
    <a class="tile-card" href="/essays/"><Icon name="pen" /><strong>Essays</strong><span>All {essays} essay questions ever set (26 and 35 marks), by topic, and a timed essay tool</span></a>
    <a class="tile-card" href="/questions/type/explain-a-view/"><Icon name="lightbulb" /><strong>Quotation questions</strong><span>Every "explain this view" and "argument against this view" pair on Papers 1 and 2, and the Paper 3 12-markers</span></a>
    <a class="tile-card" href="/flashcards/"><Icon name="layers" /><strong>Flashcards</strong><span>Key terms for {decks.length} topics with spaced repetition, and a quick-fire round of the 4-mark "describe two" questions</span></a>
    <a class="tile-card" href="/mock/"><Icon name="timer" /><strong>Mini-mock builder</strong><span>A paper-shaped timed mock from real questions: any of the four papers, with your Paper 4 sections</span></a>
    <a class="tile-card" href="/specification/"><Icon name="checklist" /><strong>Syllabus checklist</strong><span>Every content point of the 9699 syllabus, tickable, linked to its questions</span></a>
    <a class="tile-card" href="/analysis/"><Icon name="chart" /><strong>What comes up</strong><span>Marks on each syllabus topic in every series, the latest papers, every paper as a timeline</span></a>
    <a class="tile-card" href="/grade-boundaries/"><Icon name="calendar" /><strong>Thresholds and dates</strong><span>Grade calculator on Cambridge's thresholds and the June 2027 exam dates with a countdown</span></a>
    <a class="tile-card" href="/planner/"><Icon name="lightbulb" /><strong>Revision planner</strong><span>A week-by-week plan to Paper 1 from your weak topics</span></a>
    <a class="tile-card" href="/tutors/"><Icon name="users" /><strong>Your tutor</strong><span>Mark: experienced examiner, over 25 years teaching Sociology, online one-to-one</span></a>
  </div>

  <script define:vars={{ topics }}>
    try {
      const ticks = JSON.parse(localStorage.getItem('malt-cie-spec') || '{}'), scores = JSON.parse(localStorage.getItem('malt-cie-scores') || '{}');
      const nTicks = Object.values(ticks).filter(Boolean).length, rows = Object.entries(scores);
      const nQ = rows.reduce((n, [, r]) => n + (r.n || 0), 0);
      if (nTicks || nQ) {
        document.getElementById('progress').hidden = false;
        document.getElementById('pr-ticks').textContent = nTicks;
        document.getElementById('pr-q').textContent = nQ;
        const weak = rows.filter(([, r]) => r.total).sort((a, b) => a[1].earned / a[1].total - b[1].earned / b[1].total)[0];
        if (weak) { const t = topics.find((x) => x.slug === weak[0]); document.getElementById('pr-weak').innerHTML = t ? `<a href="/questions/${t.slug}/">${t.name.split(':')[0]}</a> ${Math.round(100 * weak[1].earned / weak[1].total)}%` : '—'; }
      }
    } catch {}
    const input = document.getElementById('topic-search');
    const list = document.getElementById('topic-list');
    const initial = list.innerHTML;
    input.addEventListener('input', () => {
      const q = input.value.trim().toLowerCase();
      if (!q) { list.innerHTML = initial; return; }
      const items = topics.filter((t) => t.name.toLowerCase().includes(q) || t.slug.includes(q.replace(/\s+/g, '-')));
      list.innerHTML = items.length
        ? items.map((t) => `<li><a href="/questions/${t.slug}/"><span>${t.name}</span><span class="strand">${t.parts} parts</span></a></li>`).join('')
        : '<li class="muted">No topic matches that. <a href="/questions/">Browse all topics</a>.</li>';
    });
  </script>
</Base>
