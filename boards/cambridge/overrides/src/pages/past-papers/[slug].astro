---
import Base from '../../layouts/Base.astro';
import QuestionCard from '../../components/QuestionCard.astro';
import { allPapers, byId, topicByslug, AQA_MATERIALS } from '../../lib/data';
export function getStaticPaths() {
  return allPapers.map((p) => ({ params: { slug: p.slug }, props: { paper: p } }));
}
const { paper } = Astro.props;
const qs = paper.questions.map((id) => byId.get(id)).filter(Boolean);
const old = qs.filter((q) => q.notCurrentSpec).length;
const title = `${paper.series} ${paper.paper} (${paper.spec}/${paper.comp})`;
---
<Base title={`Cambridge Sociology ${title}: questions, mark scheme and examiners' report`} description={`Every question in Cambridge International Sociology ${title}, ${paper.name}, with its topic, marks and AO split, the mark scheme and the examiners' report.`} context={`paper:${paper.slug}`} leadLine="Want a paper marked and gone through with you? Message us.">
  <h1>{paper.series}: {paper.paper} {paper.name} ({paper.spec}/{paper.comp})</h1>
  <p class="muted">{paper.qual === 'AS' ? 'AS Level' : 'A Level'} · {paper.total} marks · {qs.length} question parts · <a href={AQA_MATERIALS} rel="noopener">Cambridge's 9699 page</a>{paper.reprints?.length ? ` · ${paper.reprints.join(', ')} in this series was a word-for-word reprint of this paper` : ''}{paper.kind === 'specimen' ? ' · Specimen paper for first exams in 2021' : ''}</p>
  <h2>Question by question</h2>
  <div class="table-wrap"><table>
    <thead><tr><th>Q</th><th>Topic</th><th>Marks</th><th>AO</th><th>Type</th></tr></thead>
    <tbody>{qs.map((q) => <tr>
      <td><a href={`#${q.id}`}>{q.question}</a></td>
      <td>{q.topics.map((t, i) => <>{i ? ', ' : ''}<a href={`/questions/${t}/`}>{topicByslug.get(t)?.name ?? t}</a></>)}{q.notCurrentSpec && <span class="pill pill-hard" style="margin-left:.4rem">Old spec</span>}</td>
      <td>{q.marks}</td><td>{q.aoText}</td><td>{q.format}</td>
    </tr>)}</tbody>
  </table></div>
  <h2>The questions</h2>
  <div class="jump">{qs.map((q) => <a href={`#${q.id}`}>{q.question}</a>)}</div>
  {qs.map((q) => <QuestionCard q={q} showTopics={true} />)}
</Base>
