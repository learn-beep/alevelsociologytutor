---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
---
<Base title="Cambridge A Level Sociology 9699 mini-mock builder: timed papers from real questions" description="Build a timed mock from real Cambridge International Sociology (9699) past-paper questions in the shape of Paper 1, 2, 3 or 4, with your Paper 4 sections. Play it on screen or print it with the mark schemes." context="mock" leadLine="Want a mock marked properly and gone through? Message us.">
  <h1>Mini-mock builder</h1>
  <p>Builds a paper in the shape of the Cambridge exam from real questions, each question drawn from a different paper where possible, with linked parts (2(a) and 2(b), 3(a) and 3(b)) kept together from the same paper. Papers 1 and 2: Section A is Questions 1 to 3 (34 marks), Section B one 26-mark essay. Paper 3: 4, 8, 12 and 26 marks. Paper 4: two 35-mark essays from different sections. Timed at 1.5 minutes a mark, the pace of the real papers.</p>
  <div class="panel" id="setup">
    <h3>Paper</h3>
    <div class="chips" data-group="paper"><button class="chip" type="button" data-v="Paper 1" aria-pressed="true">Paper 1 (AS)</button><button class="chip" type="button" data-v="Paper 2">Paper 2 (AS)</button><button class="chip" type="button" data-v="Paper 3">Paper 3</button><button class="chip" type="button" data-v="Paper 4">Paper 4</button></div>
    <div id="secpick" hidden>
      <h3>Your Paper 4 sections</h3>
      <div class="chips" data-group="sec"><button class="chip" type="button" data-v="Globalisation" aria-pressed="true">Globalisation</button><button class="chip" type="button" data-v="Media" aria-pressed="true">Media</button><button class="chip" type="button" data-v="Religion">Religion</button></div>
    </div>
    <h3>Length</h3>
    <div class="chips" data-group="part"><button class="chip" type="button" data-v="A" aria-pressed="true" id="partA">Section A</button><button class="chip" type="button" data-v="B" id="partB">Section B</button><button class="chip" type="button" data-v="full">Full paper</button></div>
    <p class="muted" id="shape"></p>
    <div><button class="btn btn-accent" type="button" id="build">Build my mock</button></div>
  </div>
  <div id="paper" hidden>
    <div class="playbar"><span id="title"></span><span class="timer" id="timer"></span><span><button class="btn" type="button" id="starttimer"><Icon name="timer" />Start timer</button> <button class="btn" type="button" id="print"><Icon name="printer" />Print</button> <button class="btn" type="button" id="share"><Icon name="link" />Copy link</button></span></div>
    <div id="cards"></div>
    <div class="btn-row"><button class="btn btn-accent" type="button" id="rebuild">Build another</button></div>
  </div>
  <script>
    import { loadBank, card, shuffle, fmtTime } from '../../scripts/player.js';
    const $ = (s) => document.querySelector(s);
    const sel = { paper: 'Paper 1', part: 'A', sec: new Set(['Globalisation', 'Media']) };
    let bank = null, timer = null, secs = 0;
    const TEXT = {
      'Paper 1': { A: 'Section A: Questions 1 to 3, 4 + 8 + 6 + 10 + 6 marks (34 marks, about 50 minutes).', B: 'Section B: one 26-mark essay (about 40 minutes).', full: 'The whole paper: Section A and one essay (60 marks, 1 hour 30 minutes).' },
      'Paper 2': { A: 'Section A: Questions 1 to 3, 4 + 8 + 6 + 10 + 6 marks (34 marks, about 50 minutes).', B: 'Section B: one 26-mark essay (about 40 minutes).', full: 'The whole paper: Section A and one essay (60 marks, 1 hour 30 minutes).' },
      'Paper 3': { A: 'Questions 1 to 3: 4, 8 and 12 marks (24 marks, about 35 minutes).', B: 'Question 4: one 26-mark essay (about 40 minutes).', full: 'The whole paper (50 marks, 1 hour 15 minutes).' },
      'Paper 4': { A: 'One 35-mark essay from your first section (about 50 minutes).', B: 'One 35-mark essay from your second section (about 50 minutes).', full: 'Two essays from different sections (70 marks, 1 hour 45 minutes).' },
    };
    function shape() {
      $('#secpick').hidden = sel.paper !== 'Paper 4';
      $('#partA').textContent = sel.paper === 'Paper 4' ? 'One essay' : sel.paper === 'Paper 3' ? 'Questions 1–3' : 'Section A';
      $('#partB').textContent = sel.paper === 'Paper 4' ? 'Second section only' : sel.paper === 'Paper 3' ? 'The essay' : 'Section B';
      $('#shape').textContent = TEXT[sel.paper][sel.part] + (sel.paper === 'Paper 4' && sel.sec.size !== 2 ? ' Pick two sections.' : '');
    }
    document.querySelectorAll('[data-group="paper"], [data-group="part"]').forEach((g) => g.querySelectorAll('.chip').forEach((b) => b.addEventListener('click', () => { g.querySelectorAll('.chip').forEach((x) => x.setAttribute('aria-pressed', 'false')); b.setAttribute('aria-pressed', 'true'); sel[g.dataset.group] = b.dataset.v; shape(); })));
    document.querySelectorAll('[data-group="sec"] .chip').forEach((b) => b.addEventListener('click', () => { const on = b.getAttribute('aria-pressed') !== 'true'; if (on && sel.sec.size >= 2) { const first = [...sel.sec][0]; sel.sec.delete(first); document.querySelector(`[data-group="sec"] [data-v="${first}"]`).setAttribute('aria-pressed', 'false'); } b.setAttribute('aria-pressed', String(on)); on ? sel.sec.add(b.dataset.v) : sel.sec.delete(b.dataset.v); shape(); }));
    shape();
    loadBank().then((b) => { bank = b; });
    // whole question groups (paper#question), one per slot, each from a different paper where possible
    function pickGroup(pool, test, used) {
      const groups = {}; pool.filter(test).forEach((q) => { (groups[q.g] = groups[q.g] || []).push(q); });
      const keys = shuffle(Object.keys(groups)); const k = keys.find((x) => !used.has(x.split('#')[0])) || keys[0];
      if (!k) return []; used.add(k.split('#')[0]);
      return groups[k].sort((a, b) => a.q.localeCompare(b.q, undefined, { numeric: true }));
    }
    $('#build').addEventListener('click', () => {
      if (!bank) return;
      const pool = bank.q.filter((q) => !q.old && q.c && q.p === sel.paper);
      const used = new Set(); let picked = [];
      const slot = (test) => { picked = picked.concat(pickGroup(pool, test, used)); };
      if (sel.paper === 'Paper 4') {
        if (sel.sec.size !== 2) { $('#shape').textContent = 'Pick two sections for Paper 4.'; return; }
        const [s1, s2] = [...sel.sec];
        if (sel.part !== 'B') slot((q) => q.a === s1);
        if (sel.part !== 'A') slot((q) => q.a === s2);
      } else {
        const short = sel.paper === 'Paper 3' ? [1, 2, 3] : [1, 2, 3];
        if (sel.part !== 'B') short.forEach((n) => slot((q) => q.n === n));
        if (sel.part !== 'A') slot((q) => q.f === 'Essay');
      }
      if (!picked.length) { $('#shape').textContent = 'Nothing matched; try another combination.'; return; }
      const total = picked.reduce((a, q) => a + q.m, 0);
      $('#setup').hidden = true; $('#paper').hidden = false;
      $('#title').textContent = `${sel.paper}: ${picked.length} question parts, ${total} marks`;
      secs = Math.round(total * 90); $('#timer').textContent = fmtTime(secs); if (timer) clearInterval(timer);
      renderPicked(picked);
      location.hash = 'set=' + picked.map((q) => q.id).join(',');
      window.scrollTo({ top: 0 });
    });
    function renderPicked(picked) { const holder = $('#cards'); holder.innerHTML = ''; picked.forEach((q, n) => { const c = card(q); c.querySelector('.meta strong').textContent = `Part ${n + 1} (from ${q.s} ${q.p}${q.cp ? ` (9699/${q.cp})` : ''} Q${q.q})`; holder.appendChild(c); }); }
    $('#share').addEventListener('click', async () => { const url = location.href.split('#')[0] + location.hash; try { await navigator.clipboard.writeText(url); window.maltToast && window.maltToast('Link copied'); } catch { prompt('Copy this link', url); } });
    loadBank().then(() => { const m = location.hash.match(/set=([^&]+)/); if (!m || !bank) return; const ids = m[1].split(','); const picked = ids.map((id) => bank.q.find((q) => q.id === id)).filter(Boolean); if (!picked.length) return; const total = picked.reduce((a, q) => a + q.m, 0); $('#setup').hidden = true; $('#paper').hidden = false; $('#title').textContent = `Shared mock: ${picked.length} questions, ${total} marks`; secs = Math.round(total * 90); $("#timer").textContent = fmtTime(secs); renderPicked(picked); });
    $('#starttimer').addEventListener('click', () => { if (timer) clearInterval(timer); timer = setInterval(() => { secs--; $('#timer').textContent = fmtTime(Math.max(secs, 0)); if (secs <= 0) { clearInterval(timer); $('#timer').textContent = "Time's up"; } }, 1000); });
    $('#print').addEventListener('click', () => { document.querySelectorAll('#cards img[data-src]').forEach((img) => { img.src = img.dataset.src; img.removeAttribute('data-src'); }); setTimeout(() => window.print(), 300); });
    $('#rebuild').addEventListener('click', () => { if (timer) clearInterval(timer); $('#paper').hidden = true; $('#setup').hidden = false; window.scrollTo({ top: 0 }); });
  </script>
</Base>
