---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { allQuestions, allTopics, essayTitle } from '../../lib/data';
const essays = allQuestions.filter((q) => q.marks >= 16 && !q.notCurrentSpec).sort((a, b) => b.year - a.year);
const title = (q) => essayTitle(q.text).slice(0, 260);
const byTopic = allTopics.map((t) => [t, essays.filter((q) => q.topics.includes(t.slug))]).filter(([, qs]) => qs.length);
const n30 = essays.filter((q) => q.marks === 30).length, n20 = essays.filter((q) => q.marks === 20).length, n16 = essays.filter((q) => q.marks === 16).length;
---
<Base title="Every AQA A-level Sociology essay question since 2016, by topic, with a timed essay tool" description="All 30-, 20- and 16-mark essay questions set on AQA AS and A-level Sociology since 2016, grouped by topic, with the series each was set and a timed-essay tool that reveals the mark scheme and level descriptors." context="essays" leadLine="Want your essays marked against the AQA levels? Message us.">
  <h1>Every essay title, and a timed practice tool</h1>
  <p>{n30} thirty-mark essays (A-level Papers 1 and 3), {n20} twenty-mark essays (Paper 2, Methods in Context, Theory and Methods, AS) and {n16} sixteen-mark AS research-methods essays, grouped by topic with the series each appeared in. Pick one to write under timed conditions (about 1.5 minutes a mark, the exam's pace: 45 minutes for a 30-marker, 30 for a 20-marker), then open the mark scheme with its level descriptors and indicative content and award yourself a band.</p>
  <p class="muted">Most essays give an Item: the top bands need the Item's hooks applied as well as your own knowledge, and evaluation that reaches a judgement.</p>
  <h2>Timed essay</h2>
  <div class="panel">
    <div class="chips" id="topic-chips">{byTopic.map(([t]) => <button class="chip" type="button" data-topic={t.slug} aria-pressed="false">{t.name.split(':')[0]}</button>)}</div>
    <div class="chips" data-group="marks"><button class="chip" type="button" data-v="" aria-pressed="true">Any</button><button class="chip" type="button" data-v="30">30-mark</button><button class="chip" type="button" data-v="20">20-mark</button><button class="chip" type="button" data-v="16">16-mark (AS)</button></div>
    <div><button class="btn btn-accent" type="button" id="draw">Give me a title</button> <span class="muted">(random from the selected topics, or from all)</span></div>
  </div>
  <div id="play" hidden>
    <div class="playbar"><span id="which"></span><span class="timer" id="timer">45:00</span><button class="btn" type="button" id="starttimer"><Icon name="timer" />Start the clock</button></div>
    <div id="card"></div>
    <div class="panel"><h3>Award yourself a band</h3><div class="markrow" id="levels"><span>Band:</span>{[1, 2, 3, 4, 5].map((l) => <button class="chip" type="button" data-level={l}>{l}</button>)}</div><p class="muted" id="levelnote"></p></div>
  </div>
  <h2>All titles by topic</h2>
  {byTopic.map(([t, qs]) => <><h3><a href={`/questions/${t.slug}/`}>{t.name}</a> <span class="muted">({qs.length})</span></h3>
    <div class="table-wrap"><table><thead><tr><th>Series</th><th>Paper</th><th>Marks</th><th>Title</th></tr></thead>
    <tbody>{qs.map((q) => <tr><td>{q.series}</td><td>{q.level === 'AS' ? 'AS ' : ''}{q.paper} Q{q.question}</td><td>{q.marks}</td><td><a href={`/questions/${t.slug}/#${q.id}`}>{title(q)}</a></td></tr>)}</tbody></table></div></>)}
  <script>
    import { loadBank, card, saveScore, shuffle, fmtTime } from '../../scripts/player.js';
    const $ = (s) => document.querySelector(s);
    const sel = new Set(); let marks = '', bank = null, timer = null, secs = 1800, current = null;
    document.querySelectorAll('[data-topic]').forEach((b) => b.addEventListener('click', () => { const on = b.getAttribute('aria-pressed') !== 'true'; b.setAttribute('aria-pressed', String(on)); on ? sel.add(b.dataset.topic) : sel.delete(b.dataset.topic); }));
    document.querySelectorAll('[data-group="marks"] .chip').forEach((b) => b.addEventListener('click', () => { document.querySelectorAll('[data-group="marks"] .chip').forEach((x) => x.setAttribute('aria-pressed', 'false')); b.setAttribute('aria-pressed', 'true'); marks = b.dataset.v; }));
    loadBank().then((b) => { bank = b; });
    $('#draw').addEventListener('click', () => {
      if (!bank) return;
      const pool = bank.q.filter((q) => q.m >= 16 && !q.old && q.c && (!marks || q.m === Number(marks)) && (!sel.size || q.t.some((t) => sel.has(t))));
      if (!pool.length) return;
      current = shuffle(pool)[0];
      secs = Math.round(current.m * 90);
      $('#play').hidden = false; $('#which').textContent = `${current.s} ${current.l === 'AS' ? 'AS ' : ''}${current.p} Q${current.q} (${current.m} marks)`; $('#timer').textContent = fmtTime(secs); if (timer) clearInterval(timer);
      $('#levelnote').innerHTML = 'AQA marks these in five bands (a 30-marker: 1–6, 7–12, 13–18, 19–24, 25–30). The top band needs conceptually detailed knowledge, accurate use of the Item, explicit analysis and developed evaluation that reaches a conclusion; juxtaposing views with "however" is band 3. <em>Bands summarised by the site, to be checked by our tutor.</em>';
      const holder = $('#card'); holder.innerHTML = ''; holder.appendChild(card(current));
      document.querySelectorAll('[data-level]').forEach((x) => x.setAttribute('aria-pressed', 'false'));
      window.scrollTo({ top: $('#play').offsetTop - 80, behavior: 'smooth' });
    });
    $('#starttimer').addEventListener('click', () => { if (timer) clearInterval(timer); timer = setInterval(() => { secs--; $('#timer').textContent = fmtTime(Math.max(secs, 0)); if (secs <= 0) { clearInterval(timer); $('#timer').textContent = "Time's up"; } }, 1000); });
    document.querySelectorAll('[data-level]').forEach((b) => b.addEventListener('click', () => {
      document.querySelectorAll('[data-level]').forEach((x) => x.setAttribute('aria-pressed', 'false')); b.setAttribute('aria-pressed', 'true');
      if (current) { const table = { 30: [0, 4, 10, 16, 22, 28], 20: [0, 3, 7, 11, 15, 19], 16: [0, 2, 5, 8, 11, 15] }[current.m] || [0, 3, 7, 11, 15, 19]; saveScore(current.t, table[Number(b.dataset.level)], current.m, current.id); }
    }));
  </script>
</Base>
