---
import Base from '../../layouts/Base.astro';
import QuestionCard from '../../components/QuestionCard.astro';
import Motif from '../../components/Motif.astro';
import Icon from '../../components/Icon.astro';
import Hint from '../../components/Hint.astro';
import { allTopics, questionsForTopic, groupInfo, essayTitle } from '../../lib/data';
import { deckFor } from '../../lib/decks';
export function getStaticPaths() {
  return allTopics.map((t) => ({ params: { slug: t.slug }, props: { topic: t } }));
}
const { topic } = Astro.props;
const qs = questionsForTopic(topic.slug);
const current = qs.filter((q) => !q.notCurrentSpec);
const years = [...new Set(qs.map((q) => q.year))].sort((a, b) => b - a);
const papers = [...new Set(qs.map((q) => q.paper))].sort();
const deck = deckFor(topic.slug);
const gi = groupInfo(topic.group);
const essays = current.filter((q) => q.marks >= 16);
const tenMark = current.filter((q) => q.marks === 10);
---
<Base title={`${topic.name.split(' (')[0]}: AQA A-level Sociology past-paper questions`} description={`Every AQA A-level and AS Sociology past-paper question on ${topic.name.toLowerCase()} since 2016 (${current.length} parts), with the Items, mark schemes, examiner comments and every essay title set.`} context={`topic:${topic.slug}`}>
  <div class="topic-head"><h1>{topic.name} <span class={`badge badge-${gi.badge}`}>{gi.short}</span></h1><Motif kind={gi.motif} /></div>
  <div class="where">
    <dl>
      <dt>Where it is examined</dt><dd>{gi.where}</dd>
      <dt>Level</dt><dd>{topic.asOrA}</dd>
      <dt>Specification</dt><dd>{gi.area} ({topic.code}), {topic.statements.length} content bullet{topic.statements.length === 1 ? '' : 's'}</dd>
      <dt>Since 2016</dt><dd>{current.length} question parts: {essays.length} essays (16, 20 or 30 marks), {tenMark.length} ten-mark questions</dd>
    </dl>
  </div>
  <div class="score-note" id="myscore" hidden></div>

  {deck ? <div class="btn-row"><a class="btn btn-accent" href={`/questions/${topic.slug}/terms/`}><Icon name="layers" />Key terms cards ({deck.terms.length})</a><a class="btn" href="/practice/define/"><Icon name="target" />Define-it drill</a></div> : <p class="muted">Key-term cards for this topic are being written by our tutor. The past-paper questions below are ready now.</p>}

  <h2>Specification statements</h2>
  <ul class="spec-list">{topic.statements.map((id) => <li><strong>{id}</strong> <b>{topic.statementShort?.[id]}</b>{topic.statementShort?.[id] ? ': ' : ''}{topic.statementText[id].replace(new RegExp('^' + (topic.statementShort?.[id] || '').replace(/[.*+?^${}()|[\]\\]/g, '\\$&') + ':?\\s*'), '')}{topic.asStatements?.includes(id) && <span class="pill pill-easy" style="margin-left:.4rem">AS</span>}</li>)}</ul>

  {essays.length > 0 && <><h2>Every essay set on this topic</h2>
  <div class="table-wrap"><table><thead><tr><th>Series</th><th>Paper</th><th>Q</th><th>Marks</th><th>Title</th></tr></thead>
  <tbody>{essays.map((q) => <tr><td>{q.series}</td><td>{q.level === 'AS' ? 'AS ' : ''}{q.paper}</td><td><a href={`#${q.id}`}>{q.question}</a></td><td>{q.marks}</td><td>{essayTitle(q.text)}</td></tr>)}</tbody></table></div></>}

  <h2>Past-paper questions</h2>
  <p><a class="btn" href={`/questions/${topic.slug}/print/`}><Icon name="printer" />Print this topic as a pack</a></p>
  <div class="filterbar"><div class="chips" role="group" aria-label="Filter">
    <button class="chip" type="button" aria-pressed="true" data-filter="">All ({current.length})</button>
    <button class="chip" type="button" aria-pressed="false" data-filter="format:Outline">Outline (4–6)</button>
    <button class="chip" type="button" aria-pressed="false" data-filter="format:Outline and explain">Outline and explain (10)</button>
    <button class="chip" type="button" aria-pressed="false" data-filter="format:Analyse">Analyse (10)</button>
    <button class="chip" type="button" aria-pressed="false" data-filter="format:Essay">Essays</button>
    {papers.map((p) => <button class="chip" type="button" aria-pressed="false" data-filter={`paper:${p}`}>{p}</button>)}
    <button class="chip" type="button" aria-pressed="false" data-filter="level:AS">AS</button>
    <button class="chip" type="button" aria-pressed="false" data-filter="level:A level">A level</button>
    {years.slice(0, 3).map((y) => <button class="chip" type="button" aria-pressed="false" data-filter={`year:${y}`}>{y}</button>)}
  </div><div class="count" id="count"></div></div>
  <Hint id="reveal" text="Tap a question to zoom it. The mark scheme (with the level descriptors and indicative content) and the examiner's comment open underneath." />
  {qs.map((q) => <QuestionCard q={q} />)}

  <script define:vars={{ slug: topic.slug }}>
    try { const s = JSON.parse(localStorage.getItem('malt-scores') || '{}')[slug]; if (s && s.total) { const el = document.getElementById('myscore'); el.hidden = false; el.innerHTML = `Your practice score on this topic: <strong>${s.earned}/${s.total}</strong> (${Math.round(100 * s.earned / s.total)}%) over ${s.n} question${s.n === 1 ? '' : 's'}. <a href="/practice/">Practise more</a>`; } } catch {}
  </script>
  <script>
    const chips = document.querySelectorAll('.chip[data-filter]');
    const cards = document.querySelectorAll('.qcard');
    chips.forEach((c) => c.addEventListener('click', () => {
      chips.forEach((x) => x.setAttribute('aria-pressed', 'false'));
      c.setAttribute('aria-pressed', 'true');
      const f = c.getAttribute('data-filter') || '';
      const [key, val] = f.split(':');
      cards.forEach((card) => { card.hidden = !!f && card.getAttribute('data-' + key) !== val; });
      document.getElementById('count').textContent = `Showing ${[...cards].filter((c) => !c.hidden).length} of ${cards.length}`;
    }));
  </script>
</Base>
